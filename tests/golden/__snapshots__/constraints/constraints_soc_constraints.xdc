###############################################################################
## nanosoc constraints — TIMING (XDC, Xilinx/Vivado FPGA)
## AUTO-GENERATED by nanosoc_gen SoCConstraintsBackend.
## Scope: clocks / generated-clocks / async clock groups /
##        io-delays / false-paths. NOT pin placement (PACKAGE_PIN/
##        IOSTANDARD stay in the board pin XDC).
###############################################################################

#-------------------------------------------------------------
# Clocks
#-------------------------------------------------------------
create_clock -name rmii_ref_clk -period 20.00000 [get_ports rmii_ref_clk]  ;# u_eth_ss_0

#-------------------------------------------------------------
# Generated (derived) clocks — aggregated from module constraints:
#-------------------------------------------------------------
# u_eth_ss_0
create_generated_clock -name mii_rx_clk -divide_by 2 -source [get_pins -hierarchical -filter {NAME =~ "*u_rmii_to_mii/mrx_clk_reg/C"}] [get_pins -hierarchical -filter {NAME =~ "*u_rmii_to_mii/mrx_clk_reg/Q"}]
# u_eth_ss_0
create_generated_clock -name mii_tx_clk -divide_by 2 -source [get_pins -hierarchical -filter {NAME =~ "*u_rmii_to_mii/mtx_clk_reg/C"}] [get_pins -hierarchical -filter {NAME =~ "*u_rmii_to_mii/mtx_clk_reg/Q"}]
# u_qspi_flash_0
create_generated_clock -name qspi_sclk_i -divide_by 2 -source [get_pins -hierarchical -filter {NAME =~ "*clk_wiz_0/inst/clk_out1"}] [get_pins -hierarchical -filter {NAME =~ "*u_qspi_clock_div*QSPI_SCLK_reg*/Q"}]
# u_qspi_flash_0
create_generated_clock -name qspi_sclk -divide_by 1 -source [get_pins -hierarchical -filter {NAME =~ "*u_qspi_clock_div*QSPI_SCLK_reg*/Q"}] [get_pins -hierarchical -filter {NAME =~ "qspi_sclk"}]

#-------------------------------------------------------------
# Asynchronous clock groups
#-------------------------------------------------------------
# u_eth_ss_0
set_clock_groups -name async_sys_rmii -asynchronous -group [get_clocks {sys_clk}] -group [get_clocks {rmii_ref_clk mii_rx_clk mii_tx_clk}]

#-------------------------------------------------------------
# I/O timing (RMII / QSPI / ... — aggregated from IPs)
#-------------------------------------------------------------
set_input_delay -clock [get_clocks rmii_ref_clk] -min 2.0 [get_ports {phy_rmii_rxd[*]}]  ;# u_eth_ss_0
set_input_delay -clock [get_clocks rmii_ref_clk] -max 14.0 [get_ports {phy_rmii_rxd[*]}]  ;# u_eth_ss_0
set_input_delay -clock [get_clocks rmii_ref_clk] -min 2.0 [get_ports {phy_rmii_crs_dv}]  ;# u_eth_ss_0
set_input_delay -clock [get_clocks rmii_ref_clk] -max 14.0 [get_ports {phy_rmii_crs_dv}]  ;# u_eth_ss_0
set_output_delay -clock [get_clocks rmii_ref_clk] -min -1.0 [get_ports {phy_rmii_txd[*]}]  ;# u_eth_ss_0
set_output_delay -clock [get_clocks rmii_ref_clk] -max 5.0 [get_ports {phy_rmii_txd[*]}]  ;# u_eth_ss_0
set_output_delay -clock [get_clocks rmii_ref_clk] -min -1.0 [get_ports {phy_rmii_tx_en}]  ;# u_eth_ss_0
set_output_delay -clock [get_clocks rmii_ref_clk] -max 5.0 [get_ports {phy_rmii_tx_en}]  ;# u_eth_ss_0
set_output_delay -clock [get_clocks qspi_sclk] -min -1.0 [get_ports {qspi_io[*]}]  ;# u_qspi_flash_0
set_output_delay -clock [get_clocks qspi_sclk] -max 3.0 [get_ports {qspi_io[*]}]  ;# u_qspi_flash_0
set_output_delay -clock [get_clocks qspi_sclk] -min -1.0 [get_ports {qspi_ncs}]  ;# u_qspi_flash_0
set_output_delay -clock [get_clocks qspi_sclk] -max 3.0 [get_ports {qspi_ncs}]  ;# u_qspi_flash_0
set_input_delay -clock [get_clocks qspi_sclk] -min 1.0 [get_ports {qspi_io[*]}]  ;# u_qspi_flash_0
set_input_delay -clock [get_clocks qspi_sclk] -max 7.0 [get_ports {qspi_io[*]}]  ;# u_qspi_flash_0

#-------------------------------------------------------------
# False paths
#-------------------------------------------------------------
set_false_path -to [get_ports phy_mdc]  ;# u_eth_ss_0
set_false_path -from [get_ports dap_swclktck]
set_false_path -from [get_ports swdio]
set_false_path -to   [get_ports swdio]
