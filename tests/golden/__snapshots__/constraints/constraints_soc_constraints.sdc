#----------------------------------------------------------------------------
# nanosoc constraints — TIMING (SDC, Synopsys/ASIC)
# AUTO-GENERATED by nanosoc_gen SoCConstraintsBackend.
# Scope: clocks / clock-groups / io-delays / false-paths /
#        multicycle / pad-cell constraints. NOT pin placement.
#----------------------------------------------------------------------------

set_units -time ns
set_units -capacitance pF

#### CLOCK DEFINITION
create_clock -name sys_fclk -period 10.00000 -waveform "0 5.00000" [get_ports SYS_FCLK]
set_clock_uncertainty 0.35 [get_clocks sys_fclk]
create_clock -name swdclk -period 40.00000 -waveform "0 20.00000" [get_ports DAP_SWCLKTCK]
set_clock_uncertainty 0.35 [get_clocks swdclk]

### Asynchronous SWD <-> system clock handoff
set_clock_uncertainty -setup 0.1 -rise_from [get_clocks swdclk] -rise_to [get_clocks sys_fclk]
set_clock_uncertainty -setup 0.1 -rise_from [get_clocks sys_fclk] -rise_to [get_clocks swdclk]

### Multicycle path through asynchronous clock domains
set_multicycle_path 2 -setup -end -from swdclk -to sys_fclk
set_multicycle_path 1 -hold -end -from swdclk -to sys_fclk
set_multicycle_path 2 -setup -end -from sys_fclk -to swdclk
set_multicycle_path 1 -hold -end -from sys_fclk -to swdclk
set_false_path -hold -from sys_fclk -to swdclk

### Multicycle / false paths through pads (pad cells)
set_false_path -through uPAD_SWDIO_IO
set_multicycle_path 2 -through uPAD_SWDIO_IO
set_multicycle_path 2 -from uPAD_SWDIO_IO/I -to uPAD_SWDIO_IO/C
set_multicycle_path 2 -from uPAD_SWDIO_IO/IE -to uPAD_SWDIO_IO/C
set_multicycle_path 2 -from uPAD_SWDIO_IO/DS -to uPAD_SWDIO_IO/C
set_multicycle_path 2 -from uPAD_SWDIO_IO/OEN -to uPAD_SWDIO_IO/C
set_multicycle_path 2 -from uPAD_HOSTIO4_*/I -to uPAD_HOSTIO4_*/C
set_multicycle_path 2 -from uPAD_HOSTIO4_*/IE -to uPAD_HOSTIO4_*/C
set_multicycle_path 2 -from uPAD_HOSTIO4_*/DS -to uPAD_HOSTIO4_*/C
set_multicycle_path 2 -from uPAD_HOSTIO4_*/OEN -to uPAD_HOSTIO4_*/C

#### DELAY DEFINITION
set_input_delay -clock [get_clocks sys_fclk] -add_delay 0.1 [get_ports SYS_SYSRESETN]
set_input_delay -clock [get_clocks swdclk] -add_delay 0.1 [get_ports DAP_SWCLKTCK]

set_max_capacitance 3 [all_outputs]
set_max_fanout 10 [all_inputs]
