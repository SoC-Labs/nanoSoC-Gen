{% for i in initiators %}

  // ---------------------------------------------------------------------------
  // Initiator {{ i.up }}: shared-bus port {{ 'u_master_mux_casc' if i.mux == 'casc' else 'u_master_mux' }}.S{{ i.port }}
  // ---------------------------------------------------------------------------
