    .HSEL0(fe_{{ i.up }}_sel_shared), .HREADYOUT0(s_{{ i.up }}_hreadyout), .HRESP0(s_{{ i.up }}_hresp), .HRDATA0(s_{{ i.up }}_hrdata),
{% for p in range(1, 10) %}
{% if p <= i.private | length %}
{% set t = i.private[p - 1] %}
