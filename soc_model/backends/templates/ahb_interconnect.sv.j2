  function [31:0] {{ t.name }}_endian_swap;
    input [31:0] data_in;
    input  [1:0] swap_ctrl;
    input        big_endian;
    reg   [31:0] data_mux_1;
    begin
      data_mux_1        = (swap_ctrl[0] & big_endian) ?
        {data_in[23:16], data_in[31:24], data_in[7:0],  data_in[15:8]}  :
        {data_in[31:24], data_in[23:16], data_in[15:8],  data_in[7:0]};
      {{ t.name }}_endian_swap = (swap_ctrl[1] & big_endian) ?
        {data_mux_1[15:0], data_mux_1[31:16]} :
        {data_mux_1[31:16], data_mux_1[15:0]};
    end
  endfunction

  wire  [1:0]   i_{{ t.name }}_nxt_be_swap_ctrl;
  assign i_{{ t.name }}_nxt_be_swap_ctrl[1] = i_{{ t.name }}_be & (i_{{ t.name }}_hsize[1:0] == 2'b10);
  assign i_{{ t.name }}_nxt_be_swap_ctrl[0] = i_{{ t.name }}_be & (i_{{ t.name }}_hsize[1:0] != 2'b00);

  wire  i_{{ t.name }}_be_swap_ctrl_en;
  assign i_{{ t.name }}_be_swap_ctrl_en = i_{{ t.name }}_hsel & i_{{ t.name }}_htrans[1] & i_{{ t.name }}_hreadymux & i_{{ t.name }}_be;

  reg   [1:0]   i_{{ t.name }}_be_swap_ctrl_r;
  always @(posedge sys_hclk or negedge sys_hresetn) begin
    if (~sys_hresetn)
      i_{{ t.name }}_be_swap_ctrl_r <= 2'b00;
    else if (i_{{ t.name }}_be_swap_ctrl_en)
      i_{{ t.name }}_be_swap_ctrl_r <= i_{{ t.name }}_nxt_be_swap_ctrl;
  end

  assign i_{{ t.name }}_hwdata_le = {{ t.name }}_endian_swap(i_{{ t.name }}_hwdata, i_{{ t.name }}_be_swap_ctrl_r, i_{{ t.name }}_be);
