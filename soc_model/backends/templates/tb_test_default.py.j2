# ===========================================================================
# TBGEN_REG_001 — per-region register identity (PID/CID)
# ===========================================================================
@cocotb.test(skip=_BUS_SKIP is not None)
async def TBGEN_REG_001_register_identity(dut):
    """For targets whose model carries PID/CID reset values, assert the
    identity; otherwise the read just has to complete."""
{% if access_mode in ('adp', 'adp_direct') %}
    await _bringup(dut)
    soc = await _soc(dut)
    pid_off = (0xFE0, 0xFE4, 0xFE8, 0xFEC)
    cid_off = (0xFF0, 0xFF4, 0xFF8, 0xFFC)
    for t in M.TARGETS:
        rm = t.get("regmap")
        if not rm:
            await soc.read32(t["base"])
            continue
        if "PID" in rm:
            for off, exp in zip(pid_off, rm["PID"]):
                got = await soc.read32(t["base"] + off)
                assert (got & 0xFF) == exp, (
                    "%s PID@%#x: got %#x exp %#x" % (t["name"], off, got, exp))
        if "CID" in rm:
            for off, exp in zip(cid_off, rm["CID"]):
                got = await soc.read32(t["base"] + off)
                assert (got & 0xFF) == exp, (
                    "%s CID@%#x: got %#x exp %#x" % (t["name"], off, got, exp))
{% else %}
    pass  # skipped: {{ access_mode }}
{% endif %}


# ===========================================================================
# TBGEN_MEM_001 — writable-memory walk
# ===========================================================================
@cocotb.test(skip=_BUS_SKIP is not None)
async def TBGEN_MEM_001_memory_walk(dut):
    """Write/read-back boundaries + random words of every writable memory."""
{% if access_mode in ('adp', 'adp_direct') %}
    await _bringup(dut)
    soc = await _soc(dut)
    rng = random.Random(0xC0FFEE)
    for t in M.TARGETS:
        if t["region_type"] != "memory" or "w" not in t["access"]:
            continue
        size = t["size"]
        addrs = [t["base"], t["base"] + 4, t["base"] + max(0, size - 4)]
        addrs += [t["base"] + (rng.randrange(0, max(4, size)) & ~0x3)
                  for _ in range(4)]
        for a in addrs:
            data = rng.getrandbits(32)
            await soc.write32(a, data)
            got = await soc.read32(a)
            assert got == data, "%s @%#x: wrote %#x read %#x" % (
                t["name"], a, data, got)
{% else %}
    pass  # skipped: {{ access_mode }}
{% endif %}


