async def _bringup(dut):
    """Toggle the clock and release reset; returns once reset is deasserted."""
    # The hostio4 bridge / clock alias drives the clock in tb_top.sv, so here
    # we just wait out the reset window the TB applies (#200 ns) plus margin.
    await Timer(400, units="ns")


